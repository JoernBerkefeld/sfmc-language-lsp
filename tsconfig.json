{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "preserve",
        "moduleResolution": "bundler",
        "strict": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "dist/cjs",
        "rootDir": "src",
        "allowJs": false,
        "skipLibCheck": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist", "tests"]
}
