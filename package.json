{
    "name": "sfmc-language-lsp",
    "version": "3.16.0",
    "type": "module",
    "description": "Protocol-agnostic, browser-compatible language service for Salesforce Marketing Cloud Ã¢â‚¬â€ AMPscript, SSJS, and GTL. Provides validation, completions, hover, signature help, and code actions.",
    "author": "JÃƒÂ¶rn Berkefeld",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JoernBerkefeld/sfmc-language-lsp.git"
    },
    "bugs": {
        "url": "https://github.com/JoernBerkefeld/sfmc-language-lsp/issues"
    },
    "homepage": "https://github.com/JoernBerkefeld/sfmc-language-lsp#readme",
    "keywords": [
        "ampscript",
        "ssjs",
        "gtl",
        "sfmc",
        "salesforce",
        "marketing-cloud",
        "language-server",
        "lsp",
        "intellisense"
    ],
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.cjs",
            "types": "./dist/types/index.d.ts"
        }
    },
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.js",
    "types": "./dist/types/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "prepublishOnly": "npm run clean && npm run build",
        "build": "npm run build:cjs && npm run build:esm && npm run build:types",
        "build:cjs": "tsc -p tsconfig.cjs.json && node ./scripts/rename-cjs-output.mjs",
        "build:esm": "tsc -p tsconfig.esm.json",
        "build:types": "tsc -p tsconfig.types.json",
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "test": "node --test tests/*.test.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "prepare": "husky || true",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@handlebars/parser": "^2.2.2",
        "ampscript-data": "^3.6.0",
        "handlebars-data": "^0.3.1",
        "ssjs-data": "^1.7.0",
        "vscode-languageserver-types": "^3.18.0"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.3.3",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-unicorn": "^73.0.0",
        "globals": "^17.9.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.66.0"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts}": [
            "eslint --fix"
        ]
    }
}
